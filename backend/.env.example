# Backend Configuration Example
PROJECT_NAME="PassPass API"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=passpass
POSTGRES_PASSWORD=passpass_dev_secret
POSTGRES_DB=passpass_db

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# JWT Configuration
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Vault KDF Configuration (Argon2id key derivation — defaults are recommended)
# Encryption keys are derived from the user's password, no static key needed.
# VAULT_KDF_MEMORY_COST=65536
# VAULT_KDF_TIME_COST=3
# VAULT_KDF_PARALLELISM=4
# VAULT_KDF_SALT_LENGTH=16
