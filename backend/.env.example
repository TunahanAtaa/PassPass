# Backend Configuration Example
PROJECT_NAME="PassPass API"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration
POSTGRES_SERVER=localhost
# Match with POSTGRES_PORT defined in root .env / Docker host mapping (default 5432, or 5433)
POSTGRES_PORT=5432
POSTGRES_USER=passpass
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=passpass_db

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# JWT Configuration
# IMPORTANT: This is a placeholder for development. In production, generate a cryptographically
# secure random secret (e.g., `openssl rand -hex 32`). Never commit actual production secrets.
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Vault KDF Configuration (Argon2id key derivation — defaults are recommended)
# Encryption keys are derived from the user's password, no static key needed.
# VAULT_KDF_MEMORY_COST=65536
# VAULT_KDF_TIME_COST=3
# VAULT_KDF_PARALLELISM=4
# VAULT_KDF_SALT_LENGTH=16
